{
    "cli": {
        "version": ">= 12.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://pfe1-production.up.railway.app/api",
                "EXPO_PUBLIC_DEV_API_URL": "https://pfe1-production.up.railway.app/api"
            }
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "EXPO_PUBLIC_API_URL": "https://pfe1-production.up.railway.app/api",
                "EXPO_PUBLIC_DEV_API_URL": "https://pfe1-production.up.railway.app/api"
            }
        },
        "production": {
            "distribution": "store",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://pfe1-production.up.railway.app/api",
                "EXPO_PUBLIC_DEV_API_URL": "https://pfe1-production.up.railway.app/api"
            }
        }
    },
    "submit": {
        "production": {}
    }
}